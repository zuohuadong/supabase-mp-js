{
  "name": "supabase-mp-js",
  "version": "0.3.4",
  "description": "Official Supabase v2 client adapted for WeChat Mini Programs",
  "keywords": [
    "javascript",
    "typescript",
    "supabase",
    "miniprogram",
    "wechat"
  ],
  "homepage": "https://github.com/zuohuadong/supabase-mp-js",
  "bugs": "https://github.com/zuohuadong/supabase-mp-js/issues",
  "license": "MIT",
  "author": "zuohuadong",
  "files": [
    "dist"
  ],
  "main": "dist/main/index.js",
  "module": "dist/module/index.mjs",
  "miniprogram": "./dist/miniprogram",
  "types": "dist/module/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module/index.d.ts",
      "webpack": "./dist/miniprogram/index.js",
      "import": "./dist/module/index.mjs",
      "require": "./dist/main/index.js",
      "default": "./dist/main/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/main/index.js",
    "./dist/module/index.js",
    "./dist/module/index.mjs",
    "./dist/umd/supabase.js"
  ],
  "repository": "zuohuadong/supabase-mp-js",
  "scripts": {
    "clean": "rimraf dist docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "build": "npm run clean && npm run build:main && npm run build:module && npm run build:umd",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "build:umd": "webpack-cli --config webpack.config.js",
    "test": "jest --runInBand",
    "test:miniprogram-bundle": "node scripts/test-miniprogram-bundle.cjs",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch --verbose false --silent false"
  },
  "dependencies": {
    "@supabase/storage-js": "^2.110.2",
    "@supabase/supabase-js": "^2.110.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "jest": "^30.4.2",
    "js-yaml": "^5.2.1",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "jsdelivr": "dist/umd/supabase.js",
  "unpkg": "dist/umd/supabase.js"
}
